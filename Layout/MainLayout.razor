@inherits LayoutComponentBase

<div class="paper-grain relative min-h-screen overflow-x-clip font-body text-ink">

    <!-- Decorative blobs from the moodboard -->
    <div class="pointer-events-none absolute -right-40 -top-32 size-[34rem] rounded-[58%_42%_47%_53%/48%_58%_42%_52%] bg-peach/70" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-48 top-[52rem] size-[30rem] rounded-[45%_55%_60%_40%/55%_45%_55%_45%] bg-peach/50" aria-hidden="true"></div>

    <div class="relative z-10">
        @Body

        <footer class="mx-auto mt-16 max-w-6xl px-6 pb-10">
            <div class="flex flex-col items-center gap-3 border-t border-ink/20 pt-6 text-center sm:flex-row sm:justify-between sm:text-left">
                <p class="font-quote text-base uppercase tracking-[0.3em]">Setsunary</p>
                <p class="font-quote text-lg italic text-ink/80">because every fleeting moment deserves to be remembered.</p>
                <p class="text-xs text-ink/80">Photos via Pexels</p>
            </div>
        </footer>
    </div>
</div>
