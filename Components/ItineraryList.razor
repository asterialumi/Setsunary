<div class="flex items-center gap-2">
    <Sparkle Class="size-4 text-brown" />
    <h2 class="font-display text-2xl font-bold text-brown">Your itinerary</h2>
</div>

@if (Stops.Count == 0)
{
    <p class="mt-4 rounded-2xl border-2 border-dashed border-sand p-5 text-center font-quote text-lg italic text-ink/80">
        Nothing yet. Add a spot and your day begins to take shape.
    </p>
}
else
{
    <ol class="mt-4 space-y-3">
        @for (var i = 0; i < Stops.Count; i++)
        {
            var stop = Stops[i];
            <li class="flex items-center gap-3">
                <Photo Url="@stop.ImageUrl" Class="size-12 shrink-0 rounded-xl" />
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium"><span class="font-quote text-base italic text-brown">@(i + 1).</span> @stop.Name</p>
                    <p class="text-xs text-ink/80">@stop.DurationMinutes min</p>
                </div>
                <button type="button"
                        @onclick="() => OnRemove.InvokeAsync(stop)"
                        aria-label="Remove @stop.Name"
                        class="grid size-11 shrink-0 place-items-center rounded-full text-ink/80 transition hover:bg-peach hover:text-brown">✕</button>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public List<ShootSpot> Stops { get; set; } = new();
    [Parameter] public EventCallback<ShootSpot> OnRemove { get; set; }
}
