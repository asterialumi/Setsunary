<div class="mt-4 grid gap-3 sm:grid-cols-3" role="radiogroup" aria-label="Package">
    @foreach (var p in Packages)
    {
        var isSelected = p == Selected;
        <button type="button"
                role="radio"
                aria-checked="@(isSelected ? "true" : "false")"
                @onclick="() => OnSelect.InvokeAsync(p)"
                class="rounded-2xl border-2 p-4 text-left transition @(isSelected ? "border-brown bg-brown text-white" : "border-peach bg-white hover:border-brown")">
            <p class="font-display font-bold">@p.Name</p>
            <p class="mt-1 text-sm">@p.Tagline</p>
            <p class="mt-3 text-sm font-medium">@($"₱{p.HourlyRate:N0} / hr")</p>
            <p class="text-xs">@(p.IncludesVideo ? "Photo + video" : "Photo only")</p>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<PhotoPackage> Packages { get; set; } = new();
    [Parameter] public PhotoPackage? Selected { get; set; }
    [Parameter] public EventCallback<PhotoPackage> OnSelect { get; set; }
}
