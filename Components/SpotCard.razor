<article class="group relative flex flex-col overflow-hidden rounded-[2rem] bg-white shadow-[0_18px_50px_-30px_rgba(138,93,59,0.5)] ring-inset transition motion-safe:hover:-translate-y-1 @(IsAdded ? "ring-2 ring-brown" : "ring-1 ring-peach")">
    <div class="relative">
        <Photo Url="@Spot.ImageUrl"
               Class="aspect-[4/3] rounded-br-[3.5rem]"
               ImgClass="motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-105" />
        <span class="absolute left-4 top-4 rounded-full bg-paper/90 px-3 py-1 font-quote text-base italic text-brown">@Spot.Mood</span>
        @if (IsAdded)
        {
            <span class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-brown px-3 py-1 text-xs font-medium text-white">
                <Sparkle Class="size-3" /> In your itinerary
            </span>
        }
    </div>

    <div class="flex flex-1 flex-col p-5">
        <h3 class="font-display text-lg font-bold">@Spot.Name</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed">@Spot.Description</p>
        <p class="mt-3 text-sm text-ink/80">@Spot.DurationMinutes min</p>

        <button type="button"
                @onclick="() => OnToggle.InvokeAsync(Spot)"
                aria-pressed="@(IsAdded ? "true" : "false")"
                class="mt-4 min-h-11 w-full rounded-full border-2 border-brown px-4 py-2 text-sm font-medium transition @(IsAdded ? "bg-brown text-white hover:bg-ink hover:border-ink" : "text-brown hover:bg-peach")">
            @(IsAdded ? "Remove from itinerary" : "Add to itinerary")
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ShootSpot Spot { get; set; } = default!;
    [Parameter] public bool IsAdded { get; set; }
    [Parameter] public EventCallback<ShootSpot> OnToggle { get; set; }
}
